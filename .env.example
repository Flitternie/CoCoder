# ============================================================
# LLM Configuration — Uncomment the provider you want to use
# ============================================================

# --- OpenAI / Anthropic via Portkey gateway ---
LLM_MODEL=openai/gpt-5-mini
LLM_API_KEY=your-portkey-api-key
LLM_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=@your-virtual-key   # e.g. @28935-openai (from Portkey console)
# PORTKEY_CONFIG=pc-xxxxxxxx           # alternative: use a Portkey Config ID
# LLM_STREAM=true                      # Set to false to disable streaming


# --- Bedrock  ---
# LLM_MODEL=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# LLM_API_KEY is not needed; Bedrock uses the AWS credential chain


# --- OpenAI (direct) ---
# LLM_MODEL=openai/gpt-5-mini
# LLM_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=                    # Only needed when using a proxy or Azure

# ============================================================
# RIB Dependency Model (optional, --rib-dep-tool override)
# ============================================================
# RIB_DEP_MODEL=openai/gpt-5-mini    # Defaults to LLM_MODEL if unset
# RIB_DEP_API_KEY=                    # Defaults to LLM_API_KEY if unset
# RIB_DEP_BASE_URL=                   # Defaults to LLM_BASE_URL if unset

# ============================================================
# AWS Credentials (required for Bedrock)
# ============================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# ============================================================
# Observability (optional)
# ============================================================
LMNR_PROJECT_API_KEY=your-lmnr-project-api-key

# ============================================================
# Runtime Tuning (optional)
# ============================================================
# ENABLE_PROGRESS_TRACKING=0           # Set to 1 to enable progress tracker
# ENABLE_MERGE_GROUPS=0                # Set to 1 to enable merged group partitioning
# TERMINAL_NO_CHANGE_TIMEOUT_SECONDS=15

# ============================================================
# Test Environment (run_unit_tests.py)
# ============================================================
# Python interpreter used to create isolated venvs for unit tests.
# Python 3.10 is recommended: supports PEP 604 syntax and avoids 3.12 incompatibilities with older libs.
TEST_PYTHON_PATH=/path/to/python3.10
